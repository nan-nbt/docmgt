{
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "build",
    "scripts",
    "config",
    "src/index.js",
    "src/i18n/*",
    "src/page/*",
    "src/source/*"
  ],
  "compilerOptions": {
    "target": "ESNEXT",
    "lib": [
      "ES2021",
      "DOM"
    ],
    "rootDir": "src",
    "moduleResolution": "node",
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true
  },
  "extends": "g2fw/declaration/g2fw-tsconfig.json"
}
